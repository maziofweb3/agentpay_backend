# ==============================================================================
# AgentPay AI API Gateway (Express Backend) - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Default AI Provider)
# Get key from Google AI Studio: https://aistudio.google.com/apikey
# Multiple keys supported via comma-separated string for high-availability failover:
# GEMINI_API_KEY="AIzaSy1...,AIzaSy2..."
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# Anthropic Claude API Configuration (Alternative AI Provider)
# Get key from Anthropic Console: https://console.anthropic.com/
# Multiple keys supported via comma-separated string for high-availability failover:
# ANTHROPIC_API_KEY="sk-ant-1...,sk-ant-2..."
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="your_anthropic_claude_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# BotChain EVM Network & Token Infrastructure
# 
# Network Mode (`X402_NETWORK`):
#   - "testnet" (Default) : BotChain Testnet (Chain ID 968, CAIP-2: eip155:968)
#   - "mainnet"           : BotChain Mainnet (Chain ID 677, CAIP-2: eip155:677)
# ------------------------------------------------------------------------------
X402_NETWORK="testnet"

# BotChain Testnet Contracts (Chain 968)
BOTCHAIN_TESTNET_RPC_URL="https://rpc.bohr.life"
PAYMENT_RECIPIENT_ADDRESS_TESTNET="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"
APAY_TOKEN_ADDRESS_TESTNET="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"

# BotChain Mainnet Contracts (Chain 677) - Set when contracts are deployed on Mainnet
BOTCHAIN_MAINNET_RPC_URL="https://rpc.botchain.ai"
PAYMENT_RECIPIENT_ADDRESS_MAINNET=""
APAY_TOKEN_ADDRESS_MAINNET=""

# Fallback generic environment variables (Backward compatibility)
BOTCHAIN_RPC_URL="https://rpc.bohr.life"
PAYMENT_RECIPIENT_ADDRESS="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"
APAY_TOKEN_ADDRESS="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"

# ------------------------------------------------------------------------------
# BOF (BotChain Open Facilitator) Service Endpoint
# ------------------------------------------------------------------------------
BOF_FACILITATOR_URL="https://bof-facilitator.onrender.com"

# ------------------------------------------------------------------------------
# Server & Security
# ------------------------------------------------------------------------------
PORT=3001
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"

# ------------------------------------------------------------------------------
# Dynamic APAY Token Price Config (Optional - fetches live APAY/USD price from DEX or CoinGecko)
# ------------------------------------------------------------------------------
# API URL to fetch live APAY token price in USD (if empty, uses APAY_PRICE_FALLBACK_USD)
APAY_PRICE_API_URL="https://dex-wallet.botchain.ai/api/v1/price?token=0x4a781889Ce38c08B86b02e084A5A19609376b857&pool_type=all"
# Fallback $APAY token price in USD if API URL is empty or fails
APAY_PRICE_FALLBACK_USD="0.0038"
# In-memory price cache TTL in seconds (default: 3600 = 1 hour)
APAY_PRICE_CACHE_TTL_SEC="60"
