# ==============================================================================
# AgentPay AI API Gateway (Express Backend) - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Default AI Provider)
# Get key from Google AI Studio: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# Anthropic Claude API Configuration (Alternative AI Provider)
# Get key from Anthropic Console: https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY="your_anthropic_claude_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# BotChain EVM & Token Infrastructure
# ------------------------------------------------------------------------------
BOTCHAIN_RPC_URL="https://rpc.bohr.life"
PAYMENT_RECIPIENT_ADDRESS="0xc1eBB154EFf9bf9c08e39978E1447cC05e726dC6"
APAY_TOKEN_ADDRESS="0xFd7bF688d5a772A81DfE39da502F69FD99cE92c7"

# ------------------------------------------------------------------------------
# BOF (BotChain Open Facilitator) Service Endpoint
# ------------------------------------------------------------------------------
BOF_FACILITATOR_URL="https://bof-facilitator.onrender.com"

# ------------------------------------------------------------------------------
# Server & Security
# ------------------------------------------------------------------------------
PORT=3001
X402_NETWORK="testnet"
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"

# ------------------------------------------------------------------------------
# Dynamic APAY Token Price Config
# ------------------------------------------------------------------------------
# API URL to fetch live APAY token price in USD (if empty, uses APAY_PRICE_FALLBACK_USD)
APAY_PRICE_API_URL=""
# Fallback $APAY token price in USD if API URL is empty or fails
APAY_PRICE_FALLBACK_USD="0.0078"
# In-memory price cache TTL in seconds (default: 3600 = 1 hour)
APAY_PRICE_CACHE_TTL_SEC="3600"
